          <mxGeometry height="180" width="450" x="1260" y="600" as="geometry" />
        </mxCell>
        <mxCell id="empty" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff2cc;strokeColor=#666666;fontSize=15;spacing=12;" value="ПРОВЕРЕННЫЙ СЛУЧАЙ ПУСТОГО CSV&#xa;Задание 5c757384-f0ab-44f5-ae1b-a29759077646&#xa;input = {&quot;email&quot;:&quot;string&quot;,&quot;format&quot;:&quot;csv&quot;}&#xa;SQL фильтр: strpos(email, input.Email) &gt; 0&#xa;В БД 2 пользователя; совпадений 0 → completed, result.count = 0&#xa;Файл 39 байт: только заголовок. Уберите email или задайте &quot;&quot;." vertex="1">
          <mxGeometry height="180" width="1200" x="30" y="1070" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="3. Таблицы PostgreSQL и Redis" id="LxyXASIEO-g39LkFSHeL">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1800" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="users" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#666666;fontSize=15;spacing=12;" value="users&#xa;PK id (uuid), UNIQUE email&#xa;password_hash, blocked, auth_version&#xa;created_at, updated_at&#xa;Читают: auth / admin / export&#xa;Пишут: import / auth / admin" vertex="1">
          <mxGeometry height="180" width="380" x="30" y="70" as="geometry" />
        </mxCell>
        <mxCell id="admins" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#666666;fontSize=15;spacing=12;" value="admin_users&#xa;Отдельная таблица администраторов&#xa;Та же структура, что users&#xa;Читают: auth&#xa;Создаёт: cmd/migrate → auth.Seed" vertex="1">
          <mxGeometry height="170" width="380" x="30" y="370" as="geometry" />
        </mxCell>
        <mxCell id="jobs" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#666666;fontSize=15;spacing=12;" value="jobs&#xa;PK id; type; status&#xa;FK created_by_user_id / created_by_admin_id&#xa;data JSONB: input, result, checkpoint, files&#xa;processed / succeeded / failed / total&#xa;version / attempts / next_attempt_at&#xa;lease_owner / lease_until / artifacts_expired" vertex="1">
          <mxGeometry height="220" width="470" x="540" y="220" as="geometry" />
        </mxCell>
        <mxCell id="issues" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#666666;fontSize=15;spacing=12;" value="job_issues&#xa;PK id; FK job_id → jobs.id&#xa;item_key / severity / code / error JSONB&#xa;UNIQUE(job_id,item_key,code)&#xa;Пишет import; читает API errors/report&#xa;ON DELETE CASCADE" vertex="1">
          <mxGeometry height="180" width="460" x="1130" y="70" as="geometry" />
        </mxCell>
        <mxCell id="outbox" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#666666;fontSize=15;spacing=12;" value="outbox&#xa;PK id; FK job_id → jobs.id&#xa;available_at&#xa;Create/Recover: INSERT&#xa;Dispatch: отправка в Kafka → DELETE&#xa;ON DELETE CASCADE" vertex="1">
          <mxGeometry height="180" width="460" x="1130" y="370" as="geometry" />
        </mxCell>
        <mxCell id="audit" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#666666;fontSize=15;spacing=12;" value="audit_logs&#xa;PK id; actor_type / actor_id&#xa;action / object_id / result / request_id&#xa;created_at&#xa;Пишут auth / admin / jobs / worker&#xa;FK на акторов и объекты нет" vertex="1">
          <mxGeometry height="180" width="470" x="540" y="580" as="geometry" />
        </mxCell>
        <mxCell id="sessions" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f8cecc;strokeColor=#666666;fontSize=15;spacing=12;" value="Redis: boilerplate:session:{sid}&#xa;HASH + TTL: сессия, refresh, CSRF&#xa;Создание / refresh / logout: internal/auth&#xa;JWT проверяется вместе с сессией и аккаунтом" vertex="1">
          <mxGeometry height="150" width="490" x="30" y="890" as="geometry" />
        </mxCell>
        <mxCell id="otp" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f8cecc;strokeColor=#666666;fontSize=15;spacing=12;" value="Redis: challenge:{digest}&#xa;HASH + TTL: шаг OTP админа&#xa;reset:{role}:{digest}&#xa;Одноразовый токен сброса + TTL&#xa;Все ключи имеют prefix boilerplate:" vertex="1">
          <mxGeometry height="150" width="490" x="600" y="890" as="geometry" />
        </mxCell>
        <mxCell id="realtime" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f8cecc;strokeColor=#666666;fontSize=15;spacing=12;" value="Redis: ws-ticket:{digest}&#xa;SET + TTL → GETDEL: одноразовый WS билет&#xa;job:{job_uuid}: канал Pub/Sub&#xa;Publish: jobs → Subscribe: httpapi/realtime&#xa;Все ключи / каналы имеют prefix boilerplate:" vertex="1">
          <mxGeometry height="150" width="490" x="1170" y="890" as="geometry" />
        </mxCell>
        <mxCell id="limits" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f8cecc;strokeColor=#666666;fontSize=15;spacing=12;" value="Redis: boilerplate:limit:{sha256}&#xa;Счётчик запросов + TTL, Lua INCR / PEXPIRE&#xa;security.Allow → auth.Limit / HTTP guards" vertex="1">
          <mxGeometry height="120" width="490" x="600" y="1130" as="geometry" />
        </mxCell>
        <mxCell id="e12" edge="1" parent="1" source="jobs" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;fontSize=13;labelBackgroundColor=#ffffff;" target="users" value="FK автора: user (nullable)">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
