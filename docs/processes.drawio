  <diagram name="2. Задания — от запроса до скачивания" id="l92LE-MVy_QuxBAX-fF5">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1800" pageHeight="1500" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="client" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#666666;fontSize=15;spacing=12;" value="1. Swagger / клиент&#xa;POST /api/v1/admin/exports&#xa;{&quot;format&quot;:&quot;csv&quot;} — все пользователи" vertex="1">
          <mxGeometry height="150" width="340" x="30" y="40" as="geometry" />
        </mxCell>
        <mxCell id="api" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#666666;fontSize=15;spacing=12;" value="2. httpapi/jobs.go&#xa;Проверка прав и параметров&#xa;usertasks.CreateExport / CreateImport" vertex="1">
          <mxGeometry height="150" width="340" x="430" y="40" as="geometry" />
        </mxCell>
        <mxCell id="tx" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#666666;fontSize=15;spacing=12;" value="3. jobs.Create: одна транзакция&#xa;INSERT jobs (queued)&#xa;INSERT outbox + INSERT audit_logs" vertex="1">
          <mxGeometry height="150" width="340" x="850" y="40" as="geometry" />
        </mxCell>
        <mxCell id="dispatch" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#666666;fontSize=15;spacing=12;" value="4. worker.Dispatch (каждые 3 с)&#xa;SELECT outbox FOR UPDATE&#xa;SKIP LOCKED" vertex="1">
          <mxGeometry height="150" width="340" x="850" y="260" as="geometry" />
        </mxCell>
        <mxCell id="kafka" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffe6cc;strokeColor=#666666;fontSize=15;spacing=12;" value="5. Kafka: boilerplate.jobs.v1&#xa;Сообщение: UUID задания&#xa;После ACK: DELETE outbox + COMMIT" vertex="1">
          <mxGeometry height="150" width="340" x="430" y="260" as="geometry" />
        </mxCell>
        <mxCell id="claim" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#666666;fontSize=15;spacing=12;" value="6. worker.Run → jobs.Claim&#xa;БД: running, attempts++, lease&#xa;Запуск process; commit Kafka offset" vertex="1">
          <mxGeometry height="150" width="340" x="30" y="260" as="geometry" />
        </mxCell>
        <mxCell id="execute" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#666666;fontSize=15;spacing=12;" value="7. jobs.Execute → usertasks&#xa;Import: валидация, хеш паролей, users&#xa;Export: SELECT users с фильтрами&#xa;Согласованный снимок REPEATABLE READ" vertex="1">
          <mxGeometry height="150" width="340" x="30" y="510" as="geometry" />
        </mxCell>
        <mxCell id="files" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e1d5e7;strokeColor=#666666;fontSize=15;spacing=12;" value="8. Файлы var/jobs&#xa;Import: source → обработка / job_issues&#xa;Export: временный → result.csv/xlsx&#xa;Публикация после Finish writer и lease check" vertex="1">
          <mxGeometry height="150" width="340" x="430" y="510" as="geometry" />
        </mxCell>
        <mxCell id="finish" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#666666;fontSize=15;spacing=12;" value="9. jobs.Finish: транзакция&#xa;Сохранить jobs.data / status / version&#xa;audit_logs; снять lease&#xa;completed / completed_with_errors / failed" vertex="1">
          <mxGeometry height="150" width="340" x="850" y="510" as="geometry" />
        </mxCell>
        <mxCell id="pub" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f8cecc;strokeColor=#666666;fontSize=15;spacing=12;" value="10. jobs.Publish → Redis Pub/Sub&#xa;boilerplate:job:{id}&#xa;Публичный Snapshot, без входных данных" vertex="1">
          <mxGeometry height="150" width="340" x="850" y="770" as="geometry" />
        </mxCell>
        <mxCell id="ws" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#666666;fontSize=15;spacing=12;" value="11. httpapi/realtime.go&#xa;Одноразовый ws-ticket → WebSocket&#xa;Чтение jobs, проверка доступа и version&#xa;Периодическая сверка с БД" vertex="1">
          <mxGeometry height="150" width="340" x="430" y="770" as="geometry" />
        </mxCell>
        <mxCell id="download" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#666666;fontSize=15;spacing=12;" value="12. Клиент&#xa;GET /api/v1/admin/jobs/{id}&#xa;GET /api/v1/admin/jobs/{id}/download&#xa;POST exports возвращает 202 + JSON, не CSV" vertex="1">
          <mxGeometry height="150" width="340" x="30" y="770" as="geometry" />
        </mxCell>
