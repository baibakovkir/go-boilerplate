        <mxCell id="e15" edge="1" parent="1" source="outbox" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;fontSize=13;labelBackgroundColor=#ffffff;" target="jobs" value="job_id">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="constraint" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff2cc;strokeColor=#666666;fontSize=15;spacing=12;" value="У jobs не более одного автора: user либо admin.&#xa;Оба NULL допускаются для системных заданий.&#xa;Файлы — на диске; отдельной таблицы job_files нет.&#xa;Состояние заданий и ошибки — в PostgreSQL, не в Redis." vertex="1">
          <mxGeometry height="150" width="460" x="1130" y="620" as="geometry" />
        </mxCell>
      </root>
