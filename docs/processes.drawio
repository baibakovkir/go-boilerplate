        <mxCell id="e14" edge="1" parent="1" source="issues" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;fontSize=13;labelBackgroundColor=#ffffff;" target="jobs" value="job_id">
