        <mxCell id="recover" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff2cc;strokeColor=#666666;fontSize=15;spacing=12;" value="ВОССТАНОВЛЕНИЕ — worker.Recover (15 с)&#xa;queued, пора повторить / running, истёк lease → снова outbox&#xa;Превышен max_attempts → failed + аудит&#xa;Heartbeat продлевает lease каждые lease_ttl / 3&#xa;Временная ошибка → queued + задержка повтора" vertex="1">
          <mxGeometry height="230" width="450" x="1260" y="260" as="geometry" />
        </mxCell>
